+void* retrobox_begin_btm_request_ref(tL2C_CCB* ccb) {
+  if (ccb == nullptr || ccb->p_lcb == nullptr || ccb->p_rcb == nullptr ||
+      ccb->p_lcb->transport != BT_TRANSPORT_BR_EDR) return nullptr;
+  const auto* lcb = ccb->p_lcb;
+  const uint64_t epoch = retrobox_acl_epoch_for_lcb(lcb);
+  const retrobox::RequestIdentity id{
+      lcb->Handle(), reinterpret_cast<uintptr_t>(lcb),
+      reinterpret_cast<uintptr_t>(ccb), epoch, ccb->p_rcb->psm};
+  return g_retrobox_request_refs.Begin(id);
+}
+
+void retrobox_retire_refs_for_lcb(const tL2C_LCB* lcb) {
+  if (lcb != nullptr)
+    g_retrobox_request_refs.RetireLcb(reinterpret_cast<uintptr_t>(lcb));
+}
+void retrobox_retire_refs_for_ccb(const tL2C_CCB* ccb) {
+  if (ccb != nullptr)
+    g_retrobox_request_refs.RetireCcb(reinterpret_cast<uintptr_t>(ccb));
+}
+
+// Callback ref is a never-reused slot address, NOT a possibly recycled CCB.
+void retrobox_btm_request_ref_callback(const RawAddress* bda,
+                                      tBT_TRANSPORT transport, void* ref,
+                                      tBTM_STATUS status) {
+  auto pending = g_retrobox_request_refs.PendingIdentity(ref);
+  if (!pending) return;  // Already retired/completed or unknown.
+  if (bda == nullptr || transport != BT_TRANSPORT_BR_EDR) {
+    g_retrobox_request_refs.Retire(ref);
+    return;
+  }
+  tL2C_LCB* lcb = l2cu_find_lcb_by_bd_addr(*bda, transport);
+  if (lcb == nullptr) {
+    g_retrobox_request_refs.Retire(ref);
+    return;
+  }
+  // Only inspect CCB objects from the current LCB live queue.
+  tL2C_CCB* match = nullptr;
+  for (tL2C_CCB* c = lcb->ccb_queue.p_first_ccb; c != nullptr;
+       c = c->p_next_ccb) {
+    if (reinterpret_cast<uintptr_t>(c) == pending->ccb) {
+      match = c;
+      break;
+    }
+  }
+  if (!match || !match->p_rcb || match->p_lcb != lcb) {
+    g_retrobox_request_refs.Retire(ref);
+    return;
+  }
+  const retrobox::RequestIdentity current{
+      lcb->Handle(), reinterpret_cast<uintptr_t>(lcb),
+      reinterpret_cast<uintptr_t>(match), retrobox_acl_epoch_for_lcb(lcb),
+      match->p_rcb->psm};
+  const auto event =
+      status == BTM_DELAY_CHECK ? retrobox::SecurityEvent::kDelay :
+      (status == BTM_SUCCESS || status == BTM_SUCCESS_NO_SECURITY)
+          ? retrobox::SecurityEvent::kSuccess :
+            retrobox::SecurityEvent::kFailure;
+  auto outcome = g_retrobox_request_refs.OnCallback(ref, current, event);
+  if (!outcome.forward) return;
+  // Delegate the unchanged BTM status to the original L2CAP callback. This
+  // wrapper NEVER upgrades negative security to success.
+  l2c_link_sec_comp2(*bda, transport, match, status);
+}

diff --git a/system/bt/btif/src/btif_hh.cc b/system/bt/btif/src/btif_hh.cc
--- a/system/bt/btif/src/btif_hh.cc
+++ b/system/bt/btif/src/btif_hh.cc
@@ -124,7 +124,53 @@
 extern void bte_hh_evt(tBTA_HH_EVT event, tBTA_HH* p_data);
 extern void btif_dm_hh_open_failed(RawAddress* bdaddr);
 extern void btif_hd_service_registration();
 extern void btif_hh_timer_timeout(void* data);
+#if defined(RETROBOX_DS3_PRIVATE_DESCRIPTOR_RESEARCH)
+namespace {
+// Private, in-process, fixed-size observation payload: NO ACL epoch, NO grant.
+// No serialized C++ pointers and no changes to public tBTA_HH union/HAL ABI.
+constexpr uint16_t kRetroboxProbeEvent = 0x7f52;
+constexpr size_t kRetroboxProbeMaxBytes = 4096; // Test ceiling, not DS3 limit
+struct RetroboxProbe {
+  uint8_t handle;
+  uint8_t reserved;
+  uint16_t length;
+  uint16_t vendor_id;
+  uint16_t product_id;
+  uint8_t bytes[kRetroboxProbeMaxBytes];
+};
+static_assert(sizeof(RetroboxProbe) == 4104, "Unexpected probe wire layout");
+void btif_hh_ds3_probe_jni_event(uint16_t event, char* data) {
+  if (event != kRetroboxProbeEvent || data == nullptr) return;
+  const auto* probe = reinterpret_cast<const RetroboxProbe*>(data);
+  if (probe->length == 0 || probe->length > kRetroboxProbeMaxBytes) return;
+  // No MAC, descriptor bytes or authenticating secrets in logs.
+  BTIF_TRACE_DEBUG("DS3 research observation only: handle=%u bytes=%u",
+                   probe->handle, probe->length);
+}
+}  // namespace
+
+// Invoked from the BTA Classic HID descriptor producer only when compiled in.
+// This does NOT mint a session epoch or affect the ordinary HID callback.
+void btif_hh_ds3_probe_descriptor(uint8_t handle, uint16_t vendor_id,
+                                  uint16_t product_id, const uint8_t* descriptor,
+                                  uint16_t length) {
+  if (descriptor == nullptr || length == 0 ||
+      length > kRetroboxProbeMaxBytes) return;
+  RetroboxProbe snapshot{};
+  snapshot.handle = handle;
+  snapshot.length = length;
+  snapshot.vendor_id = vendor_id;
+  snapshot.product_id = product_id;
+  memcpy(snapshot.bytes, descriptor, length);
+  const auto result = btif_transfer_context_checked_bytes(
+      &btif_hh_ds3_probe_jni_event, kRetroboxProbeEvent,
+      reinterpret_cast<const char*>(&snapshot), sizeof(snapshot));
+  if (result != BT_STATUS_SUCCESS) {
+    BTIF_TRACE_WARNING("DS3 research observation enqueue failed");
+  }
+}
+#endif
 

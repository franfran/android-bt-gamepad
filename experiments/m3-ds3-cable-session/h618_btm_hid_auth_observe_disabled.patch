diff --git a/system/bt/stack/btm/btm_sec.cc b/system/bt/stack/btm/btm_sec.cc
--- a/system/bt/stack/btm/btm_sec.cc
+++ b/system/bt/stack/btm/btm_sec.cc
@@ -1731,10 +1731,20 @@
   } else {
     security_required = p_serv_rec->security_flags;
   }
 
+#if defined(RETROBOX_DS3_BTM_AUTH_OBSERVE)
+  // Read-only, no address/key/PIN logged; does NOT authorize cable-paired HID.
+  // PSM is available HERE; the requirements helper below drops it.
+  if (!is_originator && (psm == 0x0011 || psm == 0x0013)) {
+    LOG_INFO("RetroBox observe inbound HID PSM=0x%04x security=0x%04x "
+             "security_mode=%u",
+             psm, security_required,
+             static_cast<unsigned>(btm_cb.security_mode));
+  }
+#endif
   return btm_sec_l2cap_access_req_by_requirement(
       bd_addr, security_required, is_originator, p_callback, p_ref_data);
 }
 
